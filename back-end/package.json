{
  "type": "module",
  "name": "back-end",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch --env-file=.env ./index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "try:embeddings": "tsx --env-file=.env ./scripts/try-embeddings.ts",
    "try:extract": "tsx ./scripts/try-extract.ts",
    "try:chunks": "tsx ./scripts/try-chunks.ts",
    "ingest:samples": "tsx --env-file=.env ./scripts/ingest-samples.ts",
    "typeorm": "tsx --env-file=.env ./node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm -- migration:run -d ./src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d ./src/database/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d ./src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d ./src/database/data-source.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  }
}
