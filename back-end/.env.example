DATABASE_URL=postgresql://postgres:postgres@localhost:5433/de_santos_bolos
JWT_SECRET=change-me
GEMINI_API_KEY=your-gemini-api-key
# Optional
# PORT=3000
# CORS_ORIGIN=http://localhost:5173
# GEMINI_CHAT_MODEL=gemini-3.5-flash

# Cloudflare R2 (S3-compatible object storage for product images)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=de-santos-bolos-dev
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# De Santos Bolos orders service (separate repository); the key must match its INTERNAL_API_KEY
ORDERS_SERVICE_URL=http://localhost:3001
ORDERS_SERVICE_API_KEY=same-value-as-the-orders-service-internal-api-key
